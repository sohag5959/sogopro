# Sogopro - Personal Media Downloader Environment Variables

# Dev server port (defaults to 3000)
PORT=3000

# APP_URL: Host address injected by AI Studio
APP_URL="https://sogopro.com"

# Optional: RapidAPI or Third-party Video Downloader API Key
# If not provided, Sogopro runs in Intelligent Hybrid Mode (Real oEmbed metadata extraction + direct sample download)
RAPIDAPI_KEY=""
RAPIDAPI_HOST="video-downloader-rest-api.p.rapidapi.com"

# Optional: Path to local yt-dlp binary if running in self-hosted Docker/VPS environment
YTDLP_PATH="yt-dlp"

# Optional Gemini API Key (if AI smart summary or auto-tagging is enabled)
GEMINI_API_KEY=""
